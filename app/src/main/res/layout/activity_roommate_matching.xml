<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Roommate Matching"
            android:textColor="@color/text_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tell us about yourself to find the perfect roommate."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Budget (KSh)"
                    android:textColor="@color/text_light"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Study Habits"
                    android:textColor="@color/text_light"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgStudyHabits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbEarlyBird" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Early Bird" android:textColor="@color/text_light"/>
                    <RadioButton android:id="@+id/rbNightOwl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Night Owl" android:textColor="@color/text_light"/>
                    <RadioButton android:id="@+id/rbFlexible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flexible" android:textColor="@color/text_light" android:checked="true"/>
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Smoking Preference"
                    android:textColor="@color/text_light"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchSmoking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Non-Smoking only"
                    android:textColor="@color/text_light" />

                <Button
                    android:id="@+id/btnSavePreferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Save &amp; Find Matches"
                    app:backgroundTint="@color/primaryDarkBlue" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvMatchesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Top Matches"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
