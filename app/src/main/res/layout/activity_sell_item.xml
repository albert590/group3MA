<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sell an Item"
            android:textColor="@color/text_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Item Name (e.g. Study Table)"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"/>

                <EditText
                    android:id="@+id/etItemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Description"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:minLines="3"
                    android:gravity="top"/>

                <EditText
                    android:id="@+id/etItemPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Price (KSh)"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Category"
                    android:textColor="@color/text_light" />

                <Spinner
                    android:id="@+id/spinnerItemCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/white" />

                <EditText
                    android:id="@+id/etContactInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Contact (Phone/WhatsApp)"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"/>

                <Button
                    android:id="@+id/btnPostItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Post Item"
                    app:backgroundTint="@color/primaryDarkBlue" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
